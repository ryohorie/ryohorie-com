---
interface Props {
  videoId: string
  title: string
  hero?: boolean
}

const { videoId, title, hero = false } = Astro.props
const source = new URL(`https://www.youtube.com/embed/${videoId}`)
if (hero) {
  source.search = new URLSearchParams({
    autoplay: "0",
    controls: "0",
    loop: "1",
    playlist: videoId,
  }).toString()
}
---

<div class:list={["video", { hero }]}>
  <iframe
    src={source.href}
    title={title}
    width="560"
    height="315"
    loading={hero ? "eager" : "lazy"}
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<style>
  .video {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .hero {
    height: 56.25vw;
    max-height: 70vh;
    aspect-ratio: auto;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
